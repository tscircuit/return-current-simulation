{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "lib/*": ["./lib/*"],
      "tests/*": ["./tests/*"]
    },
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "lib",
    "tests",
    "scripts",
    "pages",
    "vite.config.ts",
    "cosmos.decorator.tsx",
    "cli"
  ]
}
